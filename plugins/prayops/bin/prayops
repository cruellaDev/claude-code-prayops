#!/usr/bin/env sh
# The launcher on the Bash tool's PATH.
#
# It prefers the copy in the data directory, because that is the one the
# status line runs and the one doctor reports on. When it is not there yet -
# a session that has not started since the plugin was installed - it falls
# back to the binary shipped inside the plugin rather than sending the user
# off to install something. Nothing is downloaded either way.
set -eu

root="$(cd "$(dirname "$0")/.." && pwd)"

# Resolve the data directory before running anything, and pass the resolved
# value down. Forwarding the inherited one is how state ended up in another
# plugin's directory: the copy in our own directory does not exist yet on the
# very first session, so the shipped binary below runs instead - and it sits
# at runtime/<os>_<arch>/prayops, where it cannot work out the data directory
# from its own location and would trust the environment.
. "$root/scripts/plugin-data.sh"
CLAUDE_PLUGIN_DATA="$(resolve_plugin_data)"
export CLAUDE_PLUGIN_DATA

if [ -n "$CLAUDE_PLUGIN_DATA" ] && [ -x "$CLAUDE_PLUGIN_DATA/bin/prayops" ]; then
  exec "$CLAUDE_PLUGIN_DATA/bin/prayops" "$@"
fi

case "$(uname -s)" in
  Darwin) os=darwin ;;
  Linux) os=linux ;;
  *) echo "PrayOps: $(uname -s) is not supported." >&2; exit 11 ;;
esac

case "$(uname -m)" in
  arm64 | aarch64) arch=arm64 ;;
  x86_64 | amd64) arch=amd64 ;;
  *) echo "PrayOps: $(uname -m) is not supported." >&2; exit 11 ;;
esac

shipped="$root/runtime/${os}_${arch}/prayops"
if [ ! -x "$shipped" ]; then
  echo "PrayOps: the plugin ships no binary for ${os}/${arch}." >&2
  exit 11
fi

exec "$shipped" "$@"
