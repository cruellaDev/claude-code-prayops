{
  "description": "PrayOps lifecycle state hooks. Runtime installation is never performed by hooks.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "test ! -x \"${CLAUDE_PLUGIN_DATA}/bin/prayops\" || \"${CLAUDE_PLUGIN_DATA}/bin/prayops\" hook claude",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "test ! -x \"${CLAUDE_PLUGIN_DATA}/bin/prayops\" || \"${CLAUDE_PLUGIN_DATA}/bin/prayops\" hook claude",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "test ! -x \"${CLAUDE_PLUGIN_DATA}/bin/prayops\" || \"${CLAUDE_PLUGIN_DATA}/bin/prayops\" hook claude",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "test ! -x \"${CLAUDE_PLUGIN_DATA}/bin/prayops\" || \"${CLAUDE_PLUGIN_DATA}/bin/prayops\" hook claude",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "test ! -x \"${CLAUDE_PLUGIN_DATA}/bin/prayops\" || \"${CLAUDE_PLUGIN_DATA}/bin/prayops\" hook claude",
            "timeout": 5
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "test ! -x \"${CLAUDE_PLUGIN_DATA}/bin/prayops\" || \"${CLAUDE_PLUGIN_DATA}/bin/prayops\" hook claude",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "test ! -x \"${CLAUDE_PLUGIN_DATA}/bin/prayops\" || \"${CLAUDE_PLUGIN_DATA}/bin/prayops\" hook claude",
            "timeout": 5
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "test ! -x \"${CLAUDE_PLUGIN_DATA}/bin/prayops\" || \"${CLAUDE_PLUGIN_DATA}/bin/prayops\" hook claude",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "test ! -x \"${CLAUDE_PLUGIN_DATA}/bin/prayops\" || \"${CLAUDE_PLUGIN_DATA}/bin/prayops\" hook claude",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
